
# ignore all types of ROM files
*.z64
*.v64
*.n64

# and all types of binary data files
*.bin
*.bin*
*.bak
*.bak*
*.blend
*.blend*

*__pycache__*
*.cache
BinjoAnalyzer/assets/*
!BinjoAnalyzer/assets/.gitkeep
BinjoAnalyzer/exports/*
!BinjoAnalyzer/exports/.gitkeep
BlenderAddOn/exports/*
!BlenderAddOn/exports/.gitkeep
.vs/*
.vscode/*
BlenderAddOn/.vs/*
BlenderAddOn/.vscode/*
BlenderAddOn/REBOOT_BLENDER.bat

# .NET build output / restored NuGet packages
BinjoAnalyzer/bin/
BinjoAnalyzer/obj/
BinjoAnalyzer/packages/

# addon distribution zip, rebuilt via `make zip`
/BINjo_Kazooie.zip
